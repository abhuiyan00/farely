<!--
  MERGE these into android/app/src/main/AndroidManifest.xml (do not replace it).
  Permissions go inside <manifest>; the <service> goes inside <application>.
-->

<!-- ==== permissions (inside <manifest>, before <application>) ==== -->
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<!-- Package visibility (Android 11+): the multi-app coordinator launches the
     ride app that needs the driver, so it must see + start these packages. -->
<queries>
    <package android:name="ee.mtakso.driver" />
    <package android:name="com.ubercab.driver" />
    <package android:name="taxi.android.driver" />
    <package android:name="com.mytaxi.driver" />
    <intent>
        <action android:name="android.intent.action.INSERT" />
        <data android:mimeType="vnd.android.cursor.dir/event" />
    </intent>
</queries>

<!-- ==== service (inside <application>) ==== -->
<service
    android:name=".FarelyAccessibilityService"
    android:exported="false"
    android:label="Farely Offer Reader"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
    <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
</service>

<!--
  Also add to android/app/src/main/res/values/strings.xml:
  <string name="farely_a11y_description">Reads ride-offer details shown on screen
  (fare, distance) so Farely can score them. Data stays on your device.</string>
-->
